---
interface Props {
  tags: string[];
  currentTag?: string;
}

const { tags, currentTag } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="タグフィルター">
  <ul class="flex flex-wrap gap-2">
    <li>
      <a
        href={`${base}blog`}
        class={`inline-block text-sm px-3 py-1 rounded-full border font-medium transition-colors ${
          currentTag === undefined
            ? 'bg-primary text-white border-primary'
            : 'bg-blue-50 text-blue-700 border-blue-100 hover:bg-blue-100'
        }`}
      >
        すべて
      </a>
    </li>
    {tags.map(tag => (
      <li>
        <a
          href={`${base}blog/tags/${tag}`}
          class={`inline-block text-sm px-3 py-1 rounded-full border font-medium transition-colors ${
            currentTag === tag
              ? 'bg-primary text-white border-primary'
              : 'bg-blue-50 text-blue-700 border-blue-100 hover:bg-blue-100'
          }`}
        >
          {tag}
        </a>
      </li>
    ))}
  </ul>
</nav>
