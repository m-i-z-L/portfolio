---
import type { ZennArticle } from '../../lib/zenn';

interface Props {
  article: ZennArticle;
  index?: number;
}

const { article, index = 0 } = Astro.props;

function formatDate(date: Date): string {
  return `${date.getFullYear()}/${String(date.getMonth() + 1).padStart(2, '0')}/${String(date.getDate()).padStart(2, '0')}`;
}
---

<article
  class="animate-on-scroll group bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
  data-delay={index * 80}
>
  <a href={article.url} target="_blank" rel="noopener noreferrer" class="block h-full">
    {article.imageUrl ? (
      <div class="aspect-[1200/630] overflow-hidden bg-gray-50">
        <img
          src={article.imageUrl}
          alt=""
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-[1200/630] bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center">
        <span class="text-4xl text-blue-200" aria-hidden="true">📝</span>
      </div>
    )}

    <div class="p-4">
      <h3 class="text-sm font-semibold text-gray-800 group-hover:text-primary transition-colors leading-snug mb-3 line-clamp-2">
        {article.title}
      </h3>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <time
          datetime={article.publishedAt.toISOString()}
          class="text-xs text-gray-400 shrink-0"
        >
          {formatDate(article.publishedAt)}
        </time>

        {article.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1" aria-label="タグ">
            {article.tags.map(tag => (
              <li class="text-xs bg-blue-50 text-blue-700 border border-blue-100 rounded px-1.5 py-0.5 font-medium">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </a>
</article>
